# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Transaction" pooler URI and swap the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Comma-separated list of origins allowed to call this API (your Vercel domain(s)).
ALLOWED_ORIGINS=http://localhost:5173,https://roadtoivies.com
